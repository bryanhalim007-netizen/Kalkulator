{
  "expo": {
    "name": "SKBike",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.costtosalespro.r04sec",
      "infoPlist": {
        "NSCameraUsageDescription": "Foto produk sepeda yang terjual",
        "NSPhotoLibraryUsageDescription": "Pilih foto produk dari galeri"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.emergent.costtosalespro.r04sec",
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Rajdhani-Bold.ttf",
            "./assets/fonts/Rajdhani-SemiBold.ttf",
            "./assets/fonts/Rajdhani-Medium.ttf",
            "./assets/fonts/IBMPlexSans-Regular.ttf",
            "./assets/fonts/IBMPlexSans-Medium.ttf",
            "./assets/fonts/IBMPlexSans-SemiBold.ttf"
          ]
        }
      ],
      "expo-image",
      "expo-image-picker",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
